NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/the_database"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# Email Config
RESEND_TO="to-email-address"
RESEND_FROM="your-contact-email"
RESEND_API_KEY="resend-key"

# Feature Flags
NEXT_PUBLIC_FEATURE_SEAT_MAP_ENABLED="true"
NEXT_PUBLIC_FEATURE_PAY_TO_CHAT_ENABLED="false"  # Set to "true" to enable paid conversations
NEXT_PUBLIC_FEATURE_PAY_TO_CHAT_ENABLED="false"
NEXT_PUBLIC_FEATURE_SEAT_MAP_ENABLED="false"
NEXT_PUBLIC_FEATURE_RELATED_LISTINGS_ENABLED="true"
NEXT_PUBLIC_FEATURE_BOOST_LISTINGS_ENABLED="false"
NEXT_PUBLIC_FEATURE_REPORT_USER_ENABLED="false"
NEXT_PUBLIC_FEATURE_SHOW_LISTING_ACTIVE_STATUS="false"

# AWS S3 for profile photos
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="valkyries-profile-photos"
